{
  "expo": {
    "name": "The Archive",
    "slug": "thearchive",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/splashscreen/icon.png",
    "backgroundColor": "#000000",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thearchive.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.thearchive.app"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splashscreen/icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "scheme": "thearchive"
  }
}
